{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xuxu-mail",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "MAIL_LOG_KV",
      "id": "ca98c93d63244fd59b8d1a6203561f12"
    }
  ],
  "routes": [
    {
      "pattern": "mail.xuxuclassmate.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}

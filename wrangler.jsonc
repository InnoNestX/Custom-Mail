{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "custom-mail",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "build": {
    "command": "worker-build --release --no-panic-recovery"
  },
  "kv_namespaces": [
    {
      "binding": "MAIL_LOG_KV",
      "id": "ca98c93d63244fd59b8d1a6203561f12"
    }
  ],
  "routes": [
    {
      "pattern": "mail.xuxuclassmate.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public"
  }
}

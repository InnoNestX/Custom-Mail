ADMIN_PASSWORD=
# Optional runtime overrides of config/mail.json plugin slots (no rebuild).
MAIL_PROVIDER=
MAIL_THEME=
MAIL_LAYOUT=
MAIL_LOGO=
# Optional JSON object deep-merged onto mail.json at runtime.
MAIL_CONFIG_JSON=
# Pick the secret that matches plugins.provider (or MAIL_PROVIDER).
# Unused keys can be left empty.
BREVO_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
POSTMARK_SERVER_TOKEN=
MAILERSEND_API_KEY=
SMTP2GO_API_KEY=
SPARKPOST_API_KEY=
# Fallback used when the provider-specific secret is empty.
MAIL_API_KEY=
ALLOW_ANY_HOST=1

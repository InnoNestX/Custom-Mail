{
  "name": "custom-mail",
  "version": "1.0.0",
  "private": true,
  "description": "Custom Mail — private web mail console on Cloudflare Workers (Rust)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InnoNestX/Custom-Mail.git"
  },
  "homepage": "https://innonestx.github.io/Custom-Mail/",
  "bugs": {
    "url": "https://github.com/InnoNestX/Custom-Mail/issues"
  },
  "scripts": {
    "build": "worker-build --release --no-panic-recovery",
    "dev": "wrangler dev --port 8790",
    "deploy": "npm run build && wrangler deploy",
    "test": "cargo test --lib",
    "typecheck": "cargo check --lib --target wasm32-unknown-unknown"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}

{
  "name": "custom-mail",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "MAIL_LOG_KV",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000001"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
